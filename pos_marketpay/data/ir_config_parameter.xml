<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Seconds the Market Pay Cloud API holds the process-transaction HTTP
            request before returning 202 and continuing via notification.
            See ECR API process-transaction `waitTime` query parameter.
        -->
        <record id="config_pos_marketpay_wait_time" model="ir.config_parameter" forcecreate="1">
            <field name="key">pos_marketpay.wait_time</field>
            <field name="value">20</field>
        </record>
    </data>
</odoo>
