<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_liana_event_report_graph" model="ir.ui.view">
        <field name="name">liana.event.report.graph</field>
        <field name="model">liana.event.report</field>
        <field name="arch" type="xml">
            <graph string="Liana Events" sample="1" type="line">
                <field name="create_date" interval="day"/>
                <field name="base_automation_id"/>
            </graph>
        </field>
    </record>

    <record id="view_liana_event_report_pivot" model="ir.ui.view">
        <field name="name">liana.event.report.pivot</field>
        <field name="model">liana.event.report</field>
        <field name="arch" type="xml">
            <pivot string="Liana Events" sample="1">
                <field name="create_date" interval="month" type="row"/>
                <field name="base_automation_id" type="col"/>
                <field name="partner_id" type="measure"/>
                <field name="lead_id" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_liana_event_report_search" model="ir.ui.view">
        <field name="name">liana.event.report.search</field>
        <field name="model">liana.event.report</field>
        <field name="arch" type="xml">
            <search string="Liana Events">
                <field name="base_automation_id" string="Event Type"/>
                <field name="action_id" string="Server Action"/>
                <field name="backend_id"/>
                <field name="res_model" string="Source Model"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <separator/>
                <filter string="New" name="state_new" domain="[('state', '=', 'new')]"/>
                <filter string="Exported" name="state_exported" domain="[('state', '=', 'exported')]"/>
                <filter string="Failed" name="state_failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="Trailing 12 months" name="filter_last_12m"
                        domain="[('create_date', '&gt;=', '-1y'), ('create_date', '&lt;', '+1d =0H')]"/>
                <separator/>
                <filter name="filter_create_date" date="create_date"/>
                <group>
                    <filter string="Event Date: Day" name="group_by_create_date_day"
                            context="{'group_by': 'create_date:day'}"/>
                    <filter string="Event Date: Week" name="group_by_create_date_week"
                            context="{'group_by': 'create_date:week'}"/>
                    <filter string="Event Date: Month" name="group_by_create_date_month"
                            context="{'group_by': 'create_date:month'}"/>
                    <separator/>
                    <filter string="Event Type" name="group_by_automation"
                            context="{'group_by': 'base_automation_id'}"/>
                    <filter string="Server Action" name="group_by_action"
                            context="{'group_by': 'action_id'}"/>
                    <filter string="Backend" name="group_by_backend"
                            context="{'group_by': 'backend_id'}"/>
                    <filter string="Source Model" name="group_by_res_model"
                            context="{'group_by': 'res_model'}"/>
                    <filter string="State" name="group_by_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_liana_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">liana.event.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="search_view_id" ref="view_liana_event_report_search"/>
        <field name="context">{
            'search_default_filter_last_12m': 1,
            'search_default_group_by_create_date_day': 1,
            'search_default_group_by_automation': 1,
            'graph_mode': 'line',
            'pivot_row_groupby': ['create_date:day'],
            'pivot_column_groupby': ['base_automation_id'],
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Liana events yet
            </p>
            <p>
                Liana events appear here once your Liana automations fire.
                Use the graph and pivot views to analyse event volume and
                the number of contacts that triggered them over time.
            </p>
        </field>
    </record>
</odoo>
