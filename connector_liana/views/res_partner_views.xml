<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_liana" model="ir.ui.view">
        <field name="name">res.partner.form.liana</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']/field[@name='ref']"
                   position="after">
                <field name="liana_extra1" invisible="not liana_extra1"/>
            </xpath>
        </field>
    </record>
</odoo>
