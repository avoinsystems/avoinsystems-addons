<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_liana_automation" model="ir.actions.act_window">
        <field name="name">Liana Automations</field>
        <field name="res_model">base.automation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('action_server_ids.state', '=', 'liana')]</field>
        <field name="context">{'search_default_inactive': 1, 'liana_automation_menu': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Liana Automation rule
            </p>
            <p>
                Liana Automations are <em>Automation Rules</em> that include at
                least one server action of type <em>Send Liana Automation Event</em>.
            </p>
        </field>
    </record>

    <record id="view_base_automation_form_liana" model="ir.ui.view">
        <field name="name">base.automation.form.liana</field>
        <field name="model">base.automation</field>
        <field name="inherit_id" ref="base_automation.view_base_automation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="liana_action_server_count" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='action_server_ids']" position="attributes">
                <attribute name="context">{
                    'default_model_id': model_id,
                    'is_modal': 1,
                    'default_usage': 'base_automation',
                    'is_liana_automation': context.get('liana_automation_menu'),
                    'default_state': context.get('liana_automation_menu') and 'liana' or False,
                }</attribute>
            </xpath>
        </field>
    </record>
</odoo>
