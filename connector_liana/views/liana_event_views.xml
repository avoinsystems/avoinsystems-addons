<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_liana_event_list" model="ir.ui.view">
        <field name="name">liana.event.list</field>
        <field name="model">liana.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'exported'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'new'"/>
                <field name="base_automation_id"/>
                <field name="action_id"/>
                <field name="backend_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
            </list>
        </field>
    </record>

    <record id="view_liana_event_form" model="ir.ui.view">
        <field name="name">liana.event.form</field>
        <field name="model">liana.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_send_payload_to_automation"
                        type="object"
                        string="Send to Liana Automation"
                        class="oe_highlight"
                        invisible="state not in ('new', 'failed')"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Event name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="base_automation_id"/>
                            <field name="action_id"/>
                            <field name="backend_id"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload_text"
                                   widget="text"
                                   placeholder="{}"
                                   nolabel="1"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_liana_event" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">liana.event</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_liana_event_list"/>
    </record>
</odoo>
