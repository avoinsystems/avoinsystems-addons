<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_fi_invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="inside">
                <setting id="l10n_fi_invoice_set_default" company_dependent="1"
                         string="Finnish invoice layout"
                         help="Replace the standard invoice PDF with the Finnish invoice report for this company">
                    <field name="l10n_fi_invoice_set_default"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
