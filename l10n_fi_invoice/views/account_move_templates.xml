<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_layout_finnish">
            <!-- Multicompany -->

            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"/>
            </t>

            <t t-call="l10n_fi_invoice.report_layout_header_finnish"/>
            <div class="article" style="margin:0px;padding:0px;" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                <t t-out="0" />
            </div>
            <t t-call="l10n_fi_invoice.report_layout_footer_finnish"/>
    </template>

    <template id="report_layout_header_finnish">
    </template>

    <template id="report_layout_footer_finnish">
            <div class="footer">
                <div class="text-center">
                    <ul class="list-inline">
                        <li t-if="company.phone">Phone:
                            <span t-field="company.phone"/>
                        </li>

                        <li t-if="company.email">&amp;bull;</li>
                        <li t-if="company.email">Email:
                            <span t-field="company.email"/>
                        </li>

                        <li t-if="company.website">&amp;bull;</li>
                        <li t-if="company.website">Website:
                            <span t-field="company.website"/>
                        </li>
                    </ul>

                    <ul class="list-inline">
                        <li>Page:</li>
                        <li>
                            <span class="page"/>
                        </li>
                        <li>/</li>
                        <li>
                            <span class="topage"/>
                        </li>
                    </ul>
                </div>
            </div>
    </template>

    <template id="report_invoice_finnish_document">
            <t t-call="l10n_fi_invoice.report_layout_finnish">
                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                <div class="page">
                    <!-- Custom CSS for reports is not trivial, see here:
                        https://github.com/odoo/odoo/issues/4359
                        Easier to just insert inline, since we aren't changing multiple reports -->
                    <style type="text/css">
                        .padding-correction {
                        padding-right: 15px;
                        padding-left: 15px;
                        }

                        hr {
                        border-top: 2px solid #eee;
                        margin-left: -15px;
                        margin-right: -15px;
                        margin-top: 10px;
                        margin-bottom: 10px;
                        }

                        .bank-transfer-wrap .row .row &gt; div {
                        padding-top: 5px;
                        padding-bottom: 5px;
                        }

                        .bank-transfer-label {
                        font-size: 9px;
                        text-align: right;
                        line-height: 10px;
                        padding: 3px;
                        }

                        .bank-transfer-value {
                        line-height: 1.7em;
                        }

                        .text-left {
                        text-align: left;
                        }

                        .border-right {
                        border-right: 2px solid black;
                        }

                        .border-left {
                        border-left: 2px solid black;
                        }

                        .border-bottom {
                        border-bottom: 2px solid black;
                        }

                        .medium-row &gt; div {
                        height: 4.9em;
                        }

                        .small-row &gt; div {
                        height: 2.5em;
                        }

                        .invoice-info tr td {
                        padding-left: 1em;
                        padding-right: 1em;
                        }

                        address span[itemprop=name] {
                        font-weight: bold;
                        }

                        .table-condensed &gt; thead &gt; tr &gt; th {
                        border-bottom: none;
                        }

                        .table &gt; tbody &gt; tr &gt; td {
                        border-top: none;
                        }

                        table.products-table {
                        border-bottom: 1px solid #eee;
                        }

                        table.products-table-totals td {
                        text-align: right;
                        line-height: .9em !important;
                        }

                        .totals-col {
                        width: 8em;
                        font-weight: bold;
                        }

                        .line_number {
                        color: gray;
                        position: absolute;
                        }

                        .payment-terms {
                        font-size: .7em;
                        margin-top: .5em;
                        line-height: 1em;
                        }

                        .payment-terms p {
                        margin-bottom: 0;
                        }

                        .invoice_tbody tr td:last-child, .products-table-totals tr td:last-child, .table-condensed tr td:last-child {
                        width: 160px;
                        }
                    </style>
                    <div style="height: 2.62cm; position: relative;">
                        <div class="padding-correction" style="position: absolute; width: 100%; bottom: 0;">
                            <div>
                                <div class="col-2 offset-1" style="float: none; display: inline-block; vertical-align: middle; padding-left: 3px;">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 2.1cm; max-width: 4cm;"/>
                                </div>
                                <div class="col-4" style="font-size: .85em; float: none; display: inline-block; vertical-align: middle;">
                                    <div t-field="o.company_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}"/>
                                </div>
                                <div class="col-5 text-left" style="font-weight: bold; font-size: large; float: none; display: inline-block; vertical-align: bottom; width: auto; padding-left: 14px;">
                                    <span t-if="o.move_type == 'in_refund'">Credit note</span>
                                    <span t-if="o.move_type == 'out_refund'">Credit note</span>
                                    <span t-if="o.move_type == 'in_invoice'">Invoice</span>
                                    <span t-if="o.move_type == 'out_invoice'">Invoice</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="padding-correction" style="min-height: 6.68cm">
                        <!-- Min height reduced to make invoice fit on one page. Original height was 8.68cm" -->
                        <div class="row">
                            <div class="col-6 offset-1" style="margin-top: 3em; margin-bottom: 4em; font-size:1.1em;">
                                <address t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}"/>
                                <span t-if="o.partner_id.vat">VAT:
                                    <span t-field="o.partner_id.vat"/>
                                </span>
                                <span id="partner_business_id"/>
                            </div>
                            <div class="col-5">
                                <table class="invoice-info" style="line-height: 1.5em; position:relative; top: 0.5em;">
                                    <tr>
                                        <td>
                                            <span>Invoice number</span>
                                        </td>
                                        <td>
                                            <t t-esc="o.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>Payment reference</span>
                                        </td>
                                        <td>
                                            <t t-esc="o.payment_reference"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Invoice Date</td>
                                        <td>
                                            <span t-field="o.invoice_date"/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.taxable_supply_date and o.show_taxable_supply_date">
                                        <td>Taxable Supply</td>
                                        <td>
                                            <span t-field="o.taxable_supply_date"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>Date due</span>
                                        </td>
                                        <td>
                                            <span t-field="o.invoice_date_due"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Delivery date</td>
                                        <td>
                                            <span t-field="o.date_delivered"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Payment term</td>
                                        <td>
                                            <span t-field="o.invoice_payment_term_id"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Our reference</td>
                                        <td>
                                            <span t-field="o.invoice_origin" t-if="o.move_type == 'in_invoice' or o.move_type == 'out_invoice'"/>
                                            <span t-field="o.ref" t-if="o.move_type == 'in_refund' or o.move_type == 'out_refund'"/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.move_type == 'in_invoice' or o.move_type == 'out_invoice'">
                                        <td>Your reference</td>
                                        <td>
                                            <span t-field="o.ref"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="padding-correction" style="min-height: 13.70cm;">
                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                        <t t-set="display_taxes" t-value="any(l.tax_ids for l in o.invoice_line_ids)"/>
                        <table class="table table-condensed products-table">
                            <thead>
                                <tr>
                                    <th><strong>
                                        <span class="offset-2">Description</span>
                                    </strong></th>
                                    <th><strong>Quantity</strong></th>
                                    <th class="text-right"><strong>Unit Price</strong></th>
                                    <th class="text-right" t-if="display_discount"><strong>Discount (%)</strong></th>
                                    <th class="text-right" t-if="display_taxes"><strong>Taxes</strong></th>
                                    <th class="text-right totals-col"><strong>Amount</strong></th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <tr t-foreach="o.invoice_line_ids" t-as="l">
                                    <td>
                                        <span class="line_number" t-esc="str(l_index+1) + '.'"/>
                                        <span class="offset-2" t-field="l.name" style="display:block"/>
                                    </td>
                                        <td>
                                            <span t-field="l.quantity" t-if="l.display_type != 'line_note' and l.display_type != 'line_section'"/>
                                            <span t-field="l.product_uom_id" groups="uom.group_uom" t-if="l.display_type != 'line_note' and l.display_type != 'line_section'"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="l.price_unit" t-if="l.display_type != 'line_note' and l.display_type != 'line_section'"/>
                                        </td>
                                        <td class="text-right" t-if="display_discount">
                                            <span t-field="l.discount" t-if="l.display_type != 'line_note' and l.display_type != 'line_section'"/>
                                        </td>
                                        <td class="text-right" t-if="display_taxes">
                                            <span t-esc="', '.join(map(lambda x: x.name, l.tax_ids))" t-if="l.display_type != 'line_note' and l.display_type != 'line_section'"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-if="l.display_type != 'line_note' and l.display_type != 'line_section' and o.company_price_include == 'tax_included'" t-field="l.price_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            <span t-if="l.display_type != 'line_note' and l.display_type != 'line_section' and o.company_price_include != 'tax_included'" t-field="l.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-sm-7 col-md-5 ml-auto">
                                <table class="table table-condensed products-table-totals">

                                    <!-- Tax totals summary (invoice currency), shared with the standard invoice PDF -->
                                    <t t-if="o.tax_totals" t-call="account.document_tax_totals">
                                        <t t-set="tax_totals" t-value="o.tax_totals"/>
                                        <t t-set="currency" t-value="o.currency_id"/>
                                    </t>

                                    <!--Payments-->
                                    <t t-if="print_with_payments and o.payment_state != 'invoicing_legacy'">
                                        <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                        <t t-foreach="payments_vals" t-as="payment_vals">
                                            <tr t-if="payment_vals['is_exchange'] == 0">
                                                <td>
                                                    <i class="oe_form_field text-right oe_payment_label">
                                                        <t t-if="payment_vals['is_refund']">Reversed on </t>
                                                        <t t-else="">Paid on </t>
                                                        <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/>
                                                    </i>
                                                </td>
                                                <td class="text-right totals-col">
                                                    <span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr t-if="len(payments_vals) > 0">
                                            <td><strong>Amount Due</strong></td>
                                            <td class="text-right totals-col">
                                                <span t-field="o.amount_residual"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                                <p class="text-right" t-if="o.company_id.display_invoice_amount_total_words">
                                    Total amount in words: <br/>
                                    <small class="text-muted"><span t-field="o.amount_total_words"/></small>
                                </p>
                            </div>
                        </div>

                        <t t-set="subtotals" t-value="o.tax_totals['subtotals'] if o.tax_totals else False"/>
                        <t t-set="currency" t-value="o.company_currency_id"/>
                        <div class="row" t-if="subtotals" style="page-break-inside: avoid; font-size: .8em;">
                            <div class="col-6 offset-6">
                                <table class="table table-condensed">
                                    <thead>
                                        <tr>
                                            <th><strong>Tax</strong></th>
                                            <th class="text-right"><strong>Base</strong></th>
                                            <th class="text-right"><strong>Amount</strong></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="subtotals" t-as="subtotal">
                                            <tr t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                                <td>
                                                    <span t-esc="tax_group['group_name']"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="tax_group['display_base_amount']"
                                                          t-options='{"widget": "monetary", "display_currency": currency}'
                                                    />
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="tax_group['tax_amount']"
                                                          t-options='{"widget": "monetary", "display_currency": currency}'
                                                    />
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div id="payment_term" class="payment-terms" style="margin-bottom: 1em;">
                        <p t-if="not is_html_empty(o.fiscal_position_id.note)" name="note">
                            <span t-field="o.fiscal_position_id.note"/>
                        </p>
                        <p t-if="not is_html_empty(o.taxes_legal_notes)" name="taxes_legal_notes">
                            <span t-field="o.taxes_legal_notes"/>
                        </p>
                        <t t-set="payment_term_details" t-value="o.payment_term_details"/>
                        <span id="payment_terms_note_id"
                              t-if="o.invoice_payment_term_id.note"
                              t-field="o.invoice_payment_term_id.note"
                              name="payment_term"/>
                        <t t-if="o.invoice_payment_term_id.display_on_invoice and payment_term_details and o.show_payment_term_details">
                            <t t-if="o._is_eligible_for_early_payment_discount(o.currency_id, o.invoice_date)">
                                <div id="early_payment_discount">
                                    <span t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                          t-out="o.invoice_payment_term_id._get_amount_due_after_discount(o.amount_total, o.amount_tax)"/> due if paid before
                                    <span t-out="o.invoice_payment_term_id._get_last_discount_date_formatted(o.invoice_date)"/>
                                </div>
                            </t>
                            <t t-if="len(payment_term_details) > 1" t-foreach="payment_term_details" t-as="term">
                                <div>
                                    <span t-out="term_index + 1"/> - Installment of
                                    <t t-options='{"widget": "monetary", "display_currency": o.currency_id}' t-out="term.get('amount')"/>
                                    <span> due on </span>
                                    <t t-out="term.get('date')"/>
                                </div>
                            </t>
                        </t>
                    </div>
                    <div style="margin-bottom: 1em;">
                        <span t-field="o.narration"/>
                    </div>
                    <hr/>
                    <div class="bank-transfer-wrap last-page" style="page-break-inside: avoid;">
                        <div class="row padding-correction" style="margin-bottom: 1em; font-size: .8em;">
                            <div class="col-4">
                                <div t-field="o.company_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}"/>
                            </div>
                            <div class="col-4">
                                <div>
                                    <span t-field="o.company_id.phone"/>
                                </div>
                                <div>
                                    <span t-field="o.company_id.email"/>
                                </div>
                                <div>
                                    <span t-field="o.company_id.website"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div t-if="o.company_id.city">Domicile:
                                    <span t-field="o.company_id.city"/>
                                </div>
                                <div>Business ID:
                                    <span t-field="o.company_id.company_registry"/>
                                </div>
                            </div>
                        </div>
                        <div class="row row-eq-height border-bottom" style="border-top: 1px dashed gray">
                            <div class="col-7 border-right">
                                <div class="row row-eq-height border-bottom medium-row">
                                    <div class="col-2 bank-transfer-label">
                                        <div>
                                            Recipient's
                                            account number
                                        </div>
                                    </div>
                                    <div class="col-10 border-left">
                                        <t t-if="o.partner_bank_id.acc_number">
                                            IBAN
                                            <t t-esc="o.partner_bank_id.acc_number"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row row-eq-height border-bottom">
                                    <div class="col-2 bank-transfer-label">
                                        <div>
                                            Recipient
                                        </div>
                                    </div>
                                    <div class="col-10 border-left" id="company-info" style="height: 4.5em">
                                        <div t-field="o.company_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;name&quot;], &quot;no_marker&quot;: true}" style="font-size: .8em;"/>
                                    </div>
                                </div>
                                <div class="row row-eq-height">
                                    <div class="col-2 bank-transfer-label">
                                        <div>
                                            Debtor
                                        </div>
                                    </div>
                                    <div class="col-10" id="payer-info" style="height: 6em;">
                                        <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}" style="font-size: .8em;"/>
                                    </div>
                                </div>
                                <div class="row row-eq-height border-bottom small-row">
                                    <div class="col-2 bank-transfer-label" style="font-size: 9px; text-align: right; line-height: 10px; min-height: 0;">
                                        <div>
                                            Signature
                                        </div>
                                    </div>
                                    <div class="col-10" style="min-height: 0;">
                                        <div style="border-bottom: 1px solid black; margin-top: 15px;"/>
                                    </div>
                                </div>
                                <div class="row row-eq-height small-row">
                                    <div class="col-2 bank-transfer-label">
                                        <div>
                                            From account No.
                                        </div>
                                    </div>
                                    <div class="col-10" style="border-left: 1px solid #dee2e6;">
                                    </div>
                                </div>
                            </div>
                            <div class="col-5">
                                <div class="row border-bottom medium-row">
                                    <div class="col-2 bank-transfer-label"/>
                                    <div class="col-10">
                                        <!-- BIC used to be here. Now there's space for a QR code. -->
                                        <t t-set="show_qr" t-value="o.display_qr_code and o.amount_residual"/>
                                        <t t-if="show_qr">
                                            <t t-set="qr_code_url" t-value="o._generate_qr_code(silent_errors=True)"/>
                                            <img t-if="qr_code_url" t-att-src="qr_code_url" style="max-height: 4.5em;"/>
                                        </t>
                                        <t t-set="show_link_qr" t-value="o.display_link_qr_code and o.amount_residual"/>
                                        <t t-if="show_link_qr">
                                            <t t-set="portal_qr_code" t-value="o._generate_portal_payment_qr()"/>
                                            <a t-if="portal_qr_code" t-att-href="o._get_portal_payment_link()" target="_blank">
                                                <img t-att-src="portal_qr_code" style="max-height: 4.5em;"/>
                                            </a>
                                        </t>
                                    </div>
                                </div>
                                <div class="row border-bottom">
                                    <div class="col-12" style="height: 10.5em;">
                                        Invoice number
                                        <t t-esc="o.name"/>
                                    </div>
                                </div>
                                <div class="row row-eq-height border-bottom small-row">
                                    <div class="col-2 bank-transfer-label text-left">
                                        <div>
                                            Reference No.
                                        </div>
                                    </div>
                                    <div class="col-10 border-left">
                                        <strong>
                                            <span t-field="o.payment_reference" class="bank-transfer-value"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="row row-eq-height small-row">
                                    <div class="col-2 bank-transfer-label text-left">
                                        <div>Date due</div>
                                    </div>
                                    <div class="col-4 border-left">
                                        <strong>
                                            <span t-field="o.invoice_date_due" class="bank-transfer-value"/>
                                        </strong>
                                    </div>
                                    <div class="col-6 border-left" style="padding-left: 0;">
                                        <span class="bank-transfer-label">Euro</span>
                                        <strong>
                                            <span t-field="o.amount_total" class="bank-transfer-value" style="float: right;"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-9" style="text-align: center;">
                                <t t-if="o.bank_barcode">
                                    <img style="margin-left: 2cm; margin-right: 2cm; margin-top: .2cm; width:600px; height:60px;" t-att-src="'/report/barcode/Code128/' + o.bank_barcode" />
                                    <div class="barcode-values">
                                        <t t-esc="o.bank_barcode"/>
                                    </div>
                                </t>
                            </div>
                            <div class="col-3 payment-terms">
                                <p>The payment will be issued to the recipient under the terms of payment service and
                                    only to the account number specified by the debtor.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
    </template>

    <template id="report_invoice_finnish_translate" t-name="Finnish Invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.user_id.lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                <!-- Mirror account.report_invoice_with_payments so the Finnish layout
                     can render payments + Amount Due like the standard invoice PDF. -->
                <t t-set="print_with_payments" t-value="True"/>
                <t t-call="l10n_fi_invoice.report_invoice_finnish_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- NOTE: When a company enables `l10n_fi_invoice_set_default`, the standard
         invoice PDF (account.report_invoice_with_payments) is routed to this
         report by IrActionsReport._render_qweb_pdf_prepare_streams in
         models/ir_actions_report.py. -->
    <record id="report_invoice_finnish" model="ir.actions.report">
        <field name="name">Finnish Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_fi_invoice.report_invoice_finnish_translate</field>
        <field name="report_file">l10n_fi_invoice.report_invoice_finnish_translate</field>
        <field name="print_report_name">(object.name or 'New').replace('/', '') + '.pdf'</field>
        <field name="binding_view_types">form</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="attachment">(object.name or 'New').replace('/', '') + '.pdf'</field>
    </record>

</odoo>
